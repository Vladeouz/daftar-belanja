# Salin menjadi .env: `copy .env.example .env` (CMD/PowerShell) atau `cp .env.example .env`.
# Variabel baru ditambahkan di sini setiap kali ada kode yang memakainya.

# PostgreSQL (docker compose, port 5432)
POSTGRES_USER=template
POSTGRES_PASSWORD=template
POSTGRES_DB=template

# Firebase Emulator (docker compose). Prefix "demo-" membuat emulator tidak pernah
# menyentuh project Firebase sungguhan.
FIREBASE_PROJECT_ID=demo-template
# API memverifikasi ID token ke Auth Emulator selama variabel ini di-set. Hapus di produksi
# (API menolak start bila di-set bersama NODE_ENV=production).
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# API menyimpan file ke Storage Emulator selama variabel ini di-set. Hapus di produksi.
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# Bucket Storage. Emulator menerima nama apa pun; di produksi pakai bucket project (Firebase Console).
FIREBASE_STORAGE_BUCKET=demo-template.appspot.com

# API (apps/api)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origin yang boleh memanggil API dari browser, dipisah koma. 8081 = Flutter web (--web-port 8081).
CORS_ORIGINS=http://localhost:8081
# Database utama (nilai POSTGRES_* di atas). Integration test membuat database `<nama>_test` sendiri.
DATABASE_URL=postgres://template:template@localhost:5432/template
# Jalankan pg-boss (job terjadwal, misalnya system.heartbeat) di proses API. Tidak di-set = false.
RUN_WORKER=true
# Adapter port (D-06). Tidak di-set = none: server start, tetapi port melempar error saat dipakai.
# PUSH_ADAPTER: fake (hanya dicatat) atau fcm (Firebase Cloud Messaging, butuh kredensial; tidak ada
# emulator FCM). STORAGE_ADAPTER: fake (di memori) atau firebase (Storage Emulator saat
# FIREBASE_STORAGE_EMULATOR_HOST di-set). fake ditolak bila NODE_ENV=production.
PUSH_ADAPTER=fake
STORAGE_ADAPTER=firebase
